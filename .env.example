# Copy this file to .env before running `docker compose up`.
# None of these have a production default — the application fails to start without them
# outside the "development" Spring profile. See docs/adr/15-define-http-api-and-time-contract.md.

# Activates the profile-gated demo seed (two Clubs, two Club Officers, several Students, and the
# three published demo accounts named in the README) so a fresh clone reaches a seeded Event.
# Unset this for anything beyond a local clone — the seed is never meant to run against real data.
SPRING_PROFILES_ACTIVE=development

# MongoDB connection string. Inside compose this resolves the "mongo" service by name.
MONGODB_URI=mongodb://mongo:27017/campushub

# Signs the session cookie. Generate a real one for anything beyond a local clone, e.g.:
#   openssl rand -base64 32
SESSION_SECRET=development-session-secret-change-me

# Derives the rotating check-in door code. The "development" Spring profile has a built-in
# fallback for this one secret, so a fresh clone still runs without setting it explicitly —
# it is set here anyway so the value stays visible next to the profile that supplies it.
CHECKIN_HMAC_SECRET=development-checkin-hmac-secret-change-me
